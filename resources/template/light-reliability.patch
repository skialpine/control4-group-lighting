+--- A detached, read-only diagnostic snapshot. Reading it sends no commands and changes no deadlines.
+function Light:diagnostics()
+  local pending = {}
+  for aspect, window in pairs(self.ledger.windows) do
+    pending[aspect] = {
+      kind = window.kind,
+      deadlineMs = window.deadline,
+      reportsHeard = window.heard,
+      refreshAsked = window.asked,
+      commands = #window.sent,
+    }
+  end
