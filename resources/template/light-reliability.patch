+  if self.started == nil then
+    return
+  end
   local why = unfit(report)
   if why then
     log:error("Light:report: the report is dropped: %s", why)
@@ -256,6 +259,35 @@ function Light:lost(suspended)
   self:_tellGroups()
 end
 
+--- A detached, read-only diagnostic snapshot. Reading it sends no commands and changes no deadlines.
+function Light:diagnostics()
+  local pending = {}
+  for aspect, window in pairs(self.ledger.windows) do
+    pending[aspect] = {
+      kind = window.kind,
+      deadlineMs = window.deadline,
+      reportsHeard = window.heard,
+      refreshAsked = window.asked,
+      commands = #window.sent,
+    }
+  end
+  return {
+    atMs = C4:GetTime(),
+    started = self.started == true,
+    online = self.online,
+    queuedReports = #self.waiting,
+    state = TableDeepCopy(self.motion:view()),
+    pending = pending,
+  }
+end
+
+--- End this Lua instance without talking to a proxy or device being unloaded. nil distinguishes a stopped
+--- instance from one not started yet, whose reports must wait for start().
+function Light:stop()
+  self.started, self.online, self.waiting = nil, false, {}
+  self:_endRun()
+end
+
 --- Reset Driver: end the run, tell offline until the next report, ask the device.
 function Light:reset()
   self:_endRun()
